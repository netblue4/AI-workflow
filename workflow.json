    {
      "id": "step-12",
      "number": 12,
      "phaseId": "phase-6",
      "title": "Periodic and triggered review",
      "isNew": false,
      "owners": [
        "AI Governance Team",
        "Steering Committee"
      ],
      "ownerIcon": "shield",
      "applicability": "All approved use cases",
      "applicabilityKey": "all",
      "gates": [
        {
          "type": "info",
          "text": "Model change trigger: If the vendor updates the underlying model, the risk assessment (Step 5) must be reviewed before continued use is permitted."
        },
        {
          "type": "info",
          "text": "Training feedback loop: Trends from reviews must be escalated to AI Governance Team for targeted training programmes under AI SR7."
