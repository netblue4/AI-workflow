    {
      "id": "step-3",
      "number": 3,
      "phaseId": "phase-1",
      "title": "System classification",
      "isNew": false,
      "owners": [
        "Requestor"
      ],
      "ownerIcon": "user",
      "applicability": "All tiers",
      "applicabilityKey": "all",
      "gates": [
        {
          "type": "warning",
          "text": "Tier 2 gate: Any use case producing marketing, legal, compliance, financial, code, or translation content must follow the full due diligence phase and requires AI Change Board approval."
        }
      ],
      "detailFile": "step-3.json"
    },
    {
      "id": "step-4",
      "number": 4,
      "phaseId": "phase-1",
      "title": "Data identification and DPIA",
      "isNew": false,
      "owners": [
        "Requestor",
        "Data Governance Team",
        "DPO",
        "AI Governance Team"
      ],
      "ownerIcon": "user",
      "applicability": "All tiers",
      "applicabilityKey": "all",
      "gates": [
        {
          "type": "danger",
          "text": "Hard stop: Personal, confidential, or organisation-identifying data must not enter external AI tools without approved safeguards and contracts. Escalate to AI Governance Team before proceeding."
        },
        {
          "type": "danger",
          "text": "Hard stop: If a lawful basis for personal data processing cannot be established, the use case must be rejected or redesigned to eliminate personal data."
        },
        {
          "type": "warning",
          "text": "Art.22 gate: Where the AI system makes automated decisions with legal or significant effects on data subjects, explicit consent or another Art.22(2) ground must be confirmed before proceeding."
        }
      ],
      "detailFile": "step-4.json"
    },
    {
      "id": "step-5",
      "number": 5,
      "phaseId": "phase-2",
      "title": "Risk identification",
      "isNew": false,
      "owners": [
        "AI Governance Team"
      ],
      "ownerIcon": "shield",
      "applicability": "Tier 2 / elevated risk",
      "applicabilityKey": "tier2",
      "gates": [],
