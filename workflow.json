      "isNew": false,
      "owners": [
        "AI Working Group",
        "AI Governance Team"
      ],
      "ownerIcon": "shield",
      "applicability": "Tier 2 / elevated risk",
      "applicabilityKey": "tier2",
      "gates": [
        {
          "type": "danger",
          "text": "Gate: Residual risk assessment panels are locked until both test and activation evidence is complete for each risk group."
        }
      ],
      "detailFile": "step-7.json"
    },
    {
      "id": "step-8",
      "number": 8,
      "phaseId": "phase-5",
      "title": "AI Change Board approval",
      "isNew": false,
      "owners": [
        "AI Change Board"
      ],
      "ownerIcon": "building",
      "applicability": "Tier 2 / elevated risk",
      "applicabilityKey": "tier2",
      "gates": [
        {
          "type": "success",
          "text": "On approval: Proceed to Phase 4. AI Governance Team registers the use case in the central inventory."
        },
        {
          "type": "warning",
          "text": "On rejection: Requestor notified with documented reasons. Resubmission requires material redesign."
        }
      ],
      "detailFile": "step-8.json"
    },
    {
      "id": "step-10",
      "number": 10,
      "phaseId": "phase-4",
      "title": "User obligations briefing",
      "isNew": true,
      "owners": [
        "AI Governance Team",
        "Authorised Users"
      ],
      "ownerIcon": "users",
      "applicability": "Live operation",
      "applicabilityKey": "ops",
      "accountability": {
        "system": [
          "Accuracy and hallucination risk evaluation (Steps 5 and 7)",
          "Bias detection and domain suitability (Steps 5 and 7)",
          "IP and copyright exposure (vendor terms, Step 5)",
          "Output logging and anomaly flagging (Step 6)",
          "Disclosure labelling on published content (Step 6)"
        ],
        "user": [
          "Not inputting data known to be personal, confidential, or classified",
          "Flagging outputs clearly wrong or inconsistent with professional knowledge",
          "Not publishing or acting on output without the required human review step",
          "Deleting chat history after each session as instructed",
          "Reporting anomalous, harmful, or unexpected outputs to AI Governance Team"
        ]
      },
      "gates": [
        {
          "type": "info",
          "text": "Key principle: Users are held to obligations they can actually discharge. Accuracy, bias, and IP verification are organisational controls — not individual responsibilities."
        }
      ],
      "detailFile": "step-10.json"
    },
    {
      "id": "step-11",
      "number": 11,
      "phaseId": "phase-5",
      "title": "Central inventory registration and record keeping",
      "isNew": false,
      "owners": [
        "CISO",
        "AI Governance Team"
      ],
      "ownerIcon": "shield",
      "applicability": "All approved use cases",
